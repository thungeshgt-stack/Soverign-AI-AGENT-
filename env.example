# Sovereign AI Workbench - environment configuration
# Copy this file to .env and edit as needed. Never commit your real .env.

# LLM mode: "local" (calls a local open-weight model server, e.g. Ollama) or "mock" (demo fallback, no network)
LOCAL_LLM_MODE=mock
LOCAL_LLM_ENDPOINT=http://localhost:11434
LOCAL_LLM_MODEL_NAME=qwen2.5:7b-instruct

# Vision mode: "local" or "mock"
VISION_MODE=mock
VISION_MODEL_NAME=llava

# Optional development-only cloud fallback. Leave false for sovereign/offline operation.
ENABLE_API_FALLBACK=false
API_FALLBACK_KEY=

EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K_RETRIEVAL=4
